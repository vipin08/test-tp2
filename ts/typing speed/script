const textInput = document.getElementById("textInput") as HTMLTextAreaElement;
const startBtn = document.getElementById("startBtn") as HTMLButtonElement;
const timeSpan = document.getElementById("time") as HTMLSpanElement;
const wpmSpan = document.getElementById("wpm") as HTMLSpanElement;

let seconds = 0;
let timer: number;

startBtn.addEventListener("click", () => {

    console.log("Button Clicked");

    clearInterval(timer);

    seconds = 0;

    timer = window.setInterval(() => {

        seconds++;
        timeSpan.innerText = seconds.toString();

        const words = textInput.value
            .trim()
            .split(/\s+/)
            .filter(word => word.length > 0)
            .length;

        const wpm = Math.round(words / (seconds / 60));

        wpmSpan.innerText = wpm.toString();

    }, 1000);

}); 